# PyCharm - JetBrains' own template lives at github.com/github/gitignore/blob/main/Global/JetBrains.gitignore, uncomment below to ignore the whole .idea folder (not recommended)
# .idea/

# Abstra - an AI-powered process automation framework, ignore dirs holding user credentials/local state/settings, see abstra.io/docs
.abstra/

# Visual Studio Code - VS Code's own template lives at github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore, uncomment below to ignore the whole vscode folder
# .vscode/
# Temporary file for partial code execution
tempCodeRunnerFile.py

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Streamlit
.streamlit/secrets.toml

# SPECops: trained checkpoints are regenerable binary artifacts (rerun sweep.py / extend_training.py), not source - keep results/*.csv, results/*.json, and results/*.png tracked, those are the evidence
*.pkl
*.pt
SPECops/src/results/invalid_pre_fix/

# SPECops: raw console-output dumps from long-running scripts, not source
SPECops/src/*_log.txt
