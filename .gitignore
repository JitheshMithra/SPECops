# pyenv - for a library/package you might want to ignore these since the code should run across multiple environments, otherwise check them in
# .python-version

# pipenv - recommended to commit Pipfile.lock, but skip it if collaborators have platform-specific deps pipenv might resolve differently
# Pipfile.lock

# UV - same tradeoff as Pipfile.lock, generally commit uv.lock for binary packages, commonly skipped for libraries
# uv.lock

# poetry - same tradeoff as Pipfile.lock, see python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
# poetry.lock
# poetry.toml

# pdm - same tradeoff as Pipfile.lock, pdm recommends project config in pdm.toml but excluding .pdm-python
# pdm.lock
# pdm.toml
.pdm-python
.pdm-build/

# pixi - same tradeoff as Pipfile.lock, and skip the .pixi virtualenv dir the same way you'd skip .venv
# pixi.lock
.pixi

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

